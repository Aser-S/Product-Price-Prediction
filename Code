import pandas as pd
import numpy as np
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error, r2_score
from sklearn.model_selection import cross_val_score

# Load train and test datasets
train_file_path = "train.csv"
test_file_path = "test.csv"

train_data = pd.read_csv(train_file_path)
test_data = pd.read_csv(test_file_path)

# Rename columns for better readability
columns = ['Product_ID', 'Weight', 'Fat_Content', 'Visibility', 'Category', 
           'MRP', 'Outlet_ID', 'Establishment_Year', 'Outlet_Size', 
           'Location_Type', 'Outlet_Type', 'Price']
train_data.columns = columns
test_data.columns = columns[:-1]

# Handle missing values
imputer = SimpleImputer(strategy='median')
train_data['Weight'] = imputer.fit_transform(train_data[['Weight']])
test_data['Weight'] = imputer.transform(test_data[['Weight']])

# Fill missing values in Outlet_Size with mode (as before)
train_data['Outlet_Size'] = train_data['Outlet_Size'].fillna(train_data['Outlet_Size'].mode()[0])
test_data['Outlet_Size'] = test_data['Outlet_Size'].fillna(test_data['Outlet_Size'].mode()[0])

# Feature engineering improvements 
train_data['Outlet_Age'] = 2024 - train_data['Establishment_Year']
test_data['Outlet_Age'] = 2024 - test_data['Establishment_Year']
train_data['MRP_Squared'] = train_data['MRP'] ** 2
test_data['MRP_Squared'] = test_data['MRP'] ** 2

# Group-based features: average MRP per Outlet_ID
train_data['Outlet_Avg_MRP'] = train_data.groupby('Outlet_ID')['MRP'].transform('mean')
test_data['Outlet_Avg_MRP'] = test_data.groupby('Outlet_ID')['MRP'].transform('mean')

# Additional feature engineering: Interaction terms and log transformation
train_data['Weight_Visibility_Interaction'] = train_data['Weight'] * train_data['Visibility']
test_data['Weight_Visibility_Interaction'] = test_data['Weight'] * test_data['Visibility']
train_data['Log_MRP'] = np.log1p(train_data['MRP'])
test_data['Log_MRP'] = np.log1p(test_data['MRP'])

# Drop unnecessary columns
train_data.drop(['Product_ID', 'Establishment_Year'], axis=1, inplace=True)
test_data.drop(['Product_ID', 'Establishment_Year'], axis=1, inplace=True)

# One-Hot Encoding for categorical variables
categorical_columns = ['Fat_Content', 'Category', 'Outlet_ID', 'Outlet_Size', 'Location_Type', 'Outlet_Type']
train_data = pd.get_dummies(train_data, columns=categorical_columns, drop_first=True)
test_data = pd.get_dummies(test_data, columns=categorical_columns, drop_first=True)

# Standardization: Use StandardScaler instead of MinMaxScaler
scaler = StandardScaler()
numerical_cols = ['Weight', 'Visibility', 'MRP', 'Outlet_Age', 'MRP_Squared', 'Outlet_Avg_MRP',
                  'Weight_Visibility_Interaction', 'Log_MRP']
train_data[numerical_cols] = scaler.fit_transform(train_data[numerical_cols])
test_data[numerical_cols] = scaler.transform(test_data[numerical_cols])

# Split train data into features and target variable
X_train = train_data.drop('Price', axis=1)
y_train = train_data['Price']

# Use RandomForestRegressor for better performance without overfitting
rf_model = RandomForestRegressor(n_estimators=100, random_state=1)
rf_model.fit(X_train, y_train)

# Predict on the test dataset
test_data['Predicted_Price'] = rf_model.predict(test_data)

# Save predictions for submission
rf_output_path = "rf_test_predictions_tuned.csv"
formatted_predictions = pd.DataFrame({
    'row_id': range(len(test_data)),
    'Y': test_data['Predicted_Price']
})
#formatted_predictions.to_csv(rf_output_path, index=False)

# Evaluate performance on training data for reference (using cross-validation)
train_predictions = rf_model.predict(X_train)
mse = mean_squared_error(y_train, train_predictions)
r2 = r2_score(y_train, train_predictions)

# Cross-validation score for the RandomForest model
cv_scores = cross_val_score(rf_model, X_train, y_train, cv=5, scoring='neg_mean_squared_error')
mean_cv_mse = -cv_scores.mean()

print(f"Training MSE: {mse:.3f}")
print(f"Training R^2 Score: {r2:.3f}")
print(f"Cross-validated MSE: {mean_cv_mse:.3f}")
print(f"Random Forest Predictions File Saved At: {rf_output_path}")
